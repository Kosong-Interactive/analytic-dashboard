# Supabase Data API values from the project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only PostgreSQL connection. Choose the correct connection mode during
# Phase 0.2 and never expose this value with a NEXT_PUBLIC_ prefix.
DATABASE_URL=

# Optional direct/session connection for migrations if DATABASE_URL uses the
# transaction pooler in a serverless runtime.
DIRECT_URL=

# Optional elevated API key for trusted server jobs only. Leave empty until a
# concrete operation requires bypassing Row Level Security.
SUPABASE_SECRET_KEY=
