{
  "name": "analytic-dashboard",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "npm run dev --workspace @analytic-dashboard/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "turbo": "^2.11.5"
  }
}
