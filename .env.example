# Server-only PostgreSQL connection used by application and worker queries.
DATABASE_URL=

# Optional direct or session-pooler connection used by database migrations.
# When omitted, migrations fall back to DATABASE_URL.
DIRECT_URL=

# Optional. A migrated, disposable PostgreSQL used by the database integration
# tests (they roll back, but never point this at production data). Skipped when unset.
TEST_DATABASE_URL=

# Public Supabase project URL and publishable key. Used by the dashboard login;
# both are safe for the browser. Never put the secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Gemini API key for AI classification (collector only, never the web app).
GEMINI_API_KEY=
